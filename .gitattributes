# Normalize line endings for text sources
* text=auto
*.tex text
*.bib text
*.md text
*.yml text
*.ps1 text

# Shell scripts (git hooks) must stay LF even on Windows checkouts
.githooks/* text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary

# Final PDFs in dist/ are stored in Git LFS (overrides the plain-binary rule above)
dist/*.pdf filter=lfs diff=lfs merge=lfs -text
