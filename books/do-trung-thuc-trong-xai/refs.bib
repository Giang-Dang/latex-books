@online{p21metrics,
  author       = {Gur-Arieh, Yoav and Marasović, Ana and Geva, Mor},
  title        = {Faithfulness Metrics Don't Measure Faithfulness: A Meta-Evaluation with Ground Truth},
  date         = {2026},
  eprint       = {2605.25052},
  eprinttype   = {arxiv},
  urldate      = {2026-08-24},
  note         = {Read arXiv:2605.25052v1 (2026-05-24), the only revision, all 31 pages, from the PDF, for chapter 08; chapter 09 close-read it on 2026-08-25, main text pages 1-9 plus appendices A-G pages 18-31, and re-verified the revision on the arXiv abstract page. Chapter 09 prints its measurements, all recorded with page and table anchors in research/ch09-bai-bao-neo.md. Preprint, cs.CL, no venue named. Its object is the faithfulness of chuoi suy luan, not of feature attribution: deletion, insertion, comprehensiveness, sufficiency, ROAR, sensitivity-n and infidelity appear nowhere in it, and its eight metrics are Adding Mistakes, Early Answering, Filler Tokens, SCM, FUR, CC-SHAP, Simulatability and Paraphrasing. Chapter 08 takes two things from it: the four-category grouping of metrics by what they perturb (importance-based, parameter-based, attribution-based, semantic-utility), and the paper's stated diagnosis that importance-based metrics conflate importance with faithfulness while semantic-utility metrics are satisfied by a fabricated justification. Its measurements belong to chapter 09 and chapter 08 prints none of them. The paper defines no metric by formula anywhere; all eight are described procedurally, re-confirmed across appendix D in chapter 09's read. It also never expands SCM, and never expands AUROC.},
}

