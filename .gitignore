# All build output lands in each book's build/ directory
build/

# LaTeX aux files, in case a build ever runs outside build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv

# The one build/ that is an input rather than an output. The lint fixture's
# log is fabricated, never compiled, and is what gives the log check something
# to find; without it scripts/check-chapter.tests.ps1 loses two findings on a
# fresh clone and nobody notices until it matters.
!scripts/tests/fixture-book/build/
!scripts/tests/fixture-book/build/main.log

# Generated by scripts/setup.ps1: a link to .claude/skills, which is the only
# tracked copy. Committing it would duplicate every skill.
.agents/skills/

# One checkout per in-flight branch, made by the drafting workflow. Git will not
# descend into a worktree, but without this the directory itself sits untracked
# in every status the main checkout prints.
.claude/worktrees/

# Editors / OS
.DS_Store
Thumbs.db
